# config/cron
SHELL=/bin/sh
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CRON_TZ=Europe/Berlin

# every hour at XX:50: updater only (fast)
50 * * * * cd /usr/src/app && REINDEX=1 npm run update-data > /proc/1/fd/1 2>/proc/1/fd/2

# every day at 05:30: force enrich + reindex (slow)
30 5 * * * cd /usr/src/app && FORCE_ENRICH=1 REINDEX=1 npm run update-data > /proc/1/fd/1 2>/proc/1/fd/2
